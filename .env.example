# Copy to .env (git-ignored) or export these in your shell before `python app.py`.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=black_hole_tracker
DB_USER=postgres
DB_PASSWORD=your-postgres-password
# Any long random string; generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me
FLASK_DEBUG=1
